## 5) 런처 스크립트(그대로 붙여넣어 쓰자)

### 5.1 Windows — `launch_win.bat`

```bat
@echo off
setlocal ENABLEDELAYEDEXPANSION

set EXE=TenRiff.exe
set BASE=%~dp0
cd /d "%BASE%"

:: 1) 기본 폴더 체크
if not exist "assets"  echo [E] assets 폴더가 없습니다.& goto fail_assets
if not exist "profiles" mkdir "profiles"
if not exist "profiles\default" mkdir "profiles\default"
if not exist "songs"   echo [W] songs 폴더가 비었습니다. 곡을 넣어주세요.

:: 2) 기본 설정/키맵 생성
if not exist "profiles\default\config.json" (
  echo {^"audio^":{^"rate^":48000,^"frames^":128,^"periods^":3,^"exclusive^":true},^"input^":{^"backend^":^"sdl2^"},^"speed^":{^"rate^":1.00,^"hispeed^":3.00},^"judge^":{^"pg^":15.5,^"gr^":31.0,^"gd^":55.0,^"bd^":80.0,^"hold_grace^":20,^"hold_break^":50,^"mask^":30},^"gauge^":{^"auto_shift^":true,^"refill_normal^":20.0,^"refill_easy^":30.0,^"shift_cooldown_ms^":2000,^"delta^":{^"hard^":{^"PG^":0.24,^"GR^":0.16,^"GD^":0.04,^"BD^":-1.125,^"PR^":-2.25},^"normal^":{^"PG^":0.42,^"GR^":0.28,^"GD^":0.07,^"BD^":-0.86,^"PR^":-1.73},^"easy^":{^"PG^":0.60,^"GR^":0.40,^"GD^":0.10,^"BD^":-0.60,^"PR^":-1.20}}},^"video^":{^"vsync^":false}} > "profiles\default\config.json"
)

if not exist "profiles\default\keymap.json" (
  echo {^"bindings^":{^"lane1^":^"D^",^"lane2^":^"F^",^"lane3^":^"J^",^"lane4^":^"K^",^"lane5^":^"Space^",^"lane6^":^"H^",^"lane7^":^"U^",^"lane8^":^"I^",^"lane9^":^"O^",^"lane10^":^"L^"}} > "profiles\default\keymap.json"
)

if not exist "logs" mkdir "logs"

:: 3) SDL2.dll 존재 확인(선택)
if not exist "SDL2.dll" echo [W] SDL2.dll 이 폴더에 없으면 실행이 실패할 수 있습니다.

:: 4) 실행
"%EXE%" --songs ./songs --profile default %*
set ERR=%ERRORLEVEL%

if %ERR%==0 goto ok
echo [!] 실행 실패. 코드=%ERR%
type "logs\run.log" | more
exit /b %ERR%

:ok
echo [OK] 정상 종료.
exit /b 0

:fail_assets
echo assets 폴더가 필요합니다. 압축을 다시 풀어주세요.
exit /b 11
```

### 5.2 Linux — `launch_linux.sh`

```bash
#!/usr/bin/env bash
set -euo pipefail
BASE="$(cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P)"
cd "$BASE"

EXE="./TenRiff"

# 1) 폴더 체크
[[ -d assets ]] || { echo "[E] assets 폴더 없음"; exit 11; }
mkdir -p profiles/default logs songs

# 2) 기본 설정/키맵 생성
[[ -f profiles/default/config.json ]] || cat > profiles/default/config.json <<'JSON'
{ "audio":{"rate":48000,"frames":128,"periods":3,"exclusive":true},
  "input":{"backend":"sdl2"},
  "speed":{"rate":1.00,"hispeed":3.00},
  "judge":{"pg":15.5,"gr":31.0,"gd":55.0,"bd":80.0,"hold_grace":20,"hold_break":50,"mask":30},
  "gauge":{"auto_shift":true,"refill_normal":20.0,"refill_easy":30.0,"shift_cooldown_ms":2000,
    "delta":{"hard":{"PG":0.24,"GR":0.16,"GD":0.04,"BD":-1.125,"PR":-2.25},
             "normal":{"PG":0.42,"GR":0.28,"GD":0.07,"BD":-0.86,"PR":-1.73},
             "easy":{"PG":0.60,"GR":0.40,"GD":0.10,"BD":-0.60,"PR":-1.20}} },
  "video":{"vsync":false} }
JSON

[[ -f profiles/default/keymap.json ]] || cat > profiles/default/keymap.json <<'JSON'
{ "bindings":{
  "lane1":"D","lane2":"F","lane3":"J","lane4":"K","lane5":"Space",
  "lane6":"H","lane7":"U","lane8":"I","lane9":"O","lane10":"L"} }
JSON

# 3) 실행
chmod +x "$EXE" || true
"$EXE" --songs ./songs --profile default "$@"
ERR=$?

if [[ $ERR -ne 0 ]]; then
  echo "[!] 실행 실패. 코드=$ERR"
  tail -n 200 logs/run.log 2>/dev/null || true
fi
exit $ERR
```

> 두 스크립트 모두 **추가 인자**를 그대로 게임에 전달한다. 예)
> `launch_win.bat --rate 1.20 --hispeed 3.50 --gauge hard`

---

## 6) 게임 쪽 “런처 연동” 체크 포인트

* 실행 초기에 **환경 요약**을 로그 첫 줄에 남겨라:
  `Audio 48k/128f x3 | Input SDL2 | VSync OFF | Songs ./songs | Profile default`
* 치명 오류 시 **명확한 종료코드**로 `exit()`:

  * 10 오디오, 11 자원, 12 BMS, 13 렌더, 기타 일반 1
* 결과화면에서 **Enter 입력 전까지 프로세스 종료 금지**(런처가 기다리게).

---

## 7) QA 스모크(런처 관점)

1. songs 폴더 비우고 실행 → “비었습니다” 경고 문구, 게임은 뜨되 목록만 비어 있어야 함.
2. profiles 삭제 후 실행 → 기본 config/keymap 자동 생성.
3. Windows에서 SDL2.dll 제거 → 경고 후 실행(동적 링크 실패 시 메시지 확인).
4. 실행 실패 코드별(10/11/12/13) 로그 메시지 노출 확인.
5. `launch_linux.sh --rate 1.2 --hispeed 3.5` 전달 → 곡선택 우측 요약에 반영.

---

## 8) 한 줄 요약

* **배포폴더에 런처 2개(.bat/.sh) 포함** → **자원 체크 & 기본설정 생성 & 게임 실행**.
* 게임은 **명확한 종료코드**, **사람말 로그**만 약속하면 됨.
* 이 정도면 “압축 풀고 실행”이 진짜로 된다. 😉

원하면 내가 `.bat`/`.sh`를 **네 프로젝트 네임**과 폴더 구조에 맞게 커스터마이즈해서 더 깔끔하게 정리해줄 수도 있어.
