{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "asan",
      "displayName": "MSVC AddressSanitizer",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "TENRIFF_ENABLE_TESTS": "ON",
        "TENRIFF_ENABLE_ONNX_UPSCALER": "OFF",
        "TENRIFF_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "RelWithDebInfo",
      "targets": ["bms_parser_tests", "nk3_onnx_smoke"]
    }
  ],
  "testPresets": [
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 1 }
    }
  ]
}
